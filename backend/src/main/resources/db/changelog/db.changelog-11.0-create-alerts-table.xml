<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
        Alerts System: Create alerts table for threshold-based monitoring
        
        Stores generated alerts when sender metrics breach configured thresholds.
        Supports acknowledgment, resolution, and full audit trail.
    -->

    <changeSet id="11.0-create-alerts-table" author="exensioreload" dbms="postgresql,oracle,h2">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="alerts"/>
            </not>
        </preConditions>

        <comment>
            Create alerts table for storing threshold breach alerts.
            
            This table tracks:
            - Alert generation when metrics breach thresholds
            - Acknowledgment and resolution workflow
            - Full audit trail with timestamps and user actions
        </comment>

        <createTable tableName="alerts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="alert_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="sender_id" type="INT"/>
            <column name="sender_name" type="VARCHAR(200)"/>
            <column name="site" type="VARCHAR(100)"/>
            <column name="alert_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="severity" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="threshold_value" type="INT"/>
            <column name="current_value" type="INT"/>
            <column name="message" type="VARCHAR(1000)"/>
            <column name="triggered_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="acknowledged_by" type="VARCHAR(100)"/>
            <column name="acknowledged_at" type="TIMESTAMP"/>
            <column name="resolved_by" type="VARCHAR(100)"/>
            <column name="resolved_at" type="TIMESTAMP"/>
            <column name="resolution_note" type="VARCHAR(500)"/>
        </createTable>

        <rollback>
            <dropTable tableName="alerts"/>
        </rollback>
    </changeSet>

    <changeSet id="11.0-create-alerts-indexes" author="exensioreload" dbms="postgresql,oracle,h2">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="alerts"/>
                <not>
                    <indexExists indexName="idx_alerts_status" tableName="alerts"/>
                </not>
            </and>
        </preConditions>

        <comment>Create indexes for efficient alert querying.</comment>

        <createIndex indexName="idx_alerts_status" tableName="alerts">
            <column name="status"/>
        </createIndex>

        <createIndex indexName="idx_alerts_sender_id" tableName="alerts">
            <column name="sender_id"/>
        </createIndex>

        <createIndex indexName="idx_alerts_severity" tableName="alerts">
            <column name="severity"/>
        </createIndex>

        <createIndex indexName="idx_alerts_triggered_at" tableName="alerts">
            <column name="triggered_at"/>
        </createIndex>

        <createIndex indexName="idx_alerts_alert_id" tableName="alerts">
            <column name="alert_id"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_alerts_status" tableName="alerts"/>
            <dropIndex indexName="idx_alerts_sender_id" tableName="alerts"/>
            <dropIndex indexName="idx_alerts_severity" tableName="alerts"/>
            <dropIndex indexName="idx_alerts_triggered_at" tableName="alerts"/>
            <dropIndex indexName="idx_alerts_alert_id" tableName="alerts"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
