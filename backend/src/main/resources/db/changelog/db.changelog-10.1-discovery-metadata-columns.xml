            </and>
        </preConditions>
        <comment>
            Add test_program column to load_session_payload for recipe/program filtering.
            Stores test program or recipe names (e.g., "IR71939_FT1_V1.2", "BURN_IN_125C").
        </comment>
        <addColumn tableName="load_session_payload">
            <column name="test_program" type="VARCHAR(200)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="load_session_payload" columnName="test_program"/>
        </rollback>
    </changeSet>

