<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
        Discovery Phase Enhancement: Add metadata columns for filtering
        
        Adds device, step, tester_id, and test_program columns to both
        load_session_payload and stage_records tables for enhanced filtering
        capabilities across Analytics, My Sessions, and Dashboard pages.
        
        Fixes: column "device" does not exist error for PostgreSQL
        (previous changelog 9.9 only targeted oracle,h2)
    -->

    <!-- ============================================ -->
    <!-- load_session_payload table - Add metadata columns -->
    <!-- ============================================ -->

    <changeSet id="10.1-add-device-to-load-session-payload" author="exensioreload" dbms="postgresql,oracle,h2">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="load_session_payload"/>
                <not>
                    <columnExists tableName="load_session_payload" columnName="device"/>
                </not>
            </and>
        </preConditions>
        <comment>
            Add device column to load_session_payload for device-based filtering.
            Fixes PostgreSQL migration missing from changelog 9.9 (oracle,h2 only).
        </comment>
        <addColumn tableName="load_session_payload">
            <column name="device" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="load_session_payload" columnName="device"/>
        </rollback>
    </changeSet>

    <changeSet id="10.1-add-step-to-load-session-payload" author="exensioreload" dbms="postgresql,oracle,h2">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="load_session_payload"/>
                <not>
                    <columnExists tableName="load_session_payload" columnName="step"/>
                </not>
            </and>
        </preConditions>
        <comment>
            Add step column to load_session_payload for step-based filtering.
            Stores semiconductor test step identifiers (e.g., "FT1", "FT2", "BURN-IN").
        </comment>
        <addColumn tableName="load_session_payload">
            <column name="step" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="load_session_payload" columnName="step"/>
        </rollback>
    </changeSet>

    <changeSet id="10.1-add-tester-id-to-load-session-payload" author="exensioreload" dbms="postgresql,oracle,h2">
