        </preConditions>
        <comment>
            Add tester_id column to load_session_payload for equipment-based filtering.
            Stores tester/equipment identifiers (e.g., "TESTER-01", "UF3000-05").
        </comment>
        <addColumn tableName="load_session_payload">
            <column name="tester_id" type="VARCHAR(100)">
