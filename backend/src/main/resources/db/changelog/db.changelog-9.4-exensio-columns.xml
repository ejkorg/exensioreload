<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Add exensio_wafer_key column to SENDER_STAGE -->
    <changeSet id="9.4-add-exensio-wafer-key" author="kiro">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="SENDER_STAGE"/>
                <not>
                    <columnExists tableName="SENDER_STAGE" columnName="exensio_wafer_key"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="SENDER_STAGE">
            <column name="exensio_wafer_key" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <!-- Add exensio_pg_key column to SENDER_STAGE -->
    <changeSet id="9.4-add-exensio-pg-key" author="kiro">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="SENDER_STAGE"/>
                <not>
                    <columnExists tableName="SENDER_STAGE" columnName="exensio_pg_key"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="SENDER_STAGE">
            <column name="exensio_pg_key" type="BIGINT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
