<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Add missing columns to load_session required by LoadSession entity -->
    <changeSet id="2026-08-19-01-load-session-notification-columns" author="kiro">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="load_session"/>
            <not>
                <columnExists tableName="load_session" columnName="last_checked_at"/>
            </not>
        </preConditions>

        <addColumn tableName="load_session">
            <column name="user_email" type="VARCHAR(255)"/>
        </addColumn>
        <addColumn tableName="load_session">
            <column name="notification_sent" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="load_session">
            <column name="notification_sent_at" type="TIMESTAMP"/>
        </addColumn>
        <addColumn tableName="load_session">
            <column name="last_checked_at" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
