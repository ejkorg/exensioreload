<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="6.2-add-stage-request-id" author="antigravity">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="SENDER_STAGE" />
                <not>
                    <columnExists tableName="SENDER_STAGE" columnName="request_id" />
                </not>
            </and>
        </preConditions>
        <addColumn tableName="SENDER_STAGE">
            <column name="request_id" type="VARCHAR(128)" />
        </addColumn>
    </changeSet>

</databaseChangeLog>
