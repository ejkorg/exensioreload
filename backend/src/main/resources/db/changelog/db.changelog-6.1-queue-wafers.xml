<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Create sender_queue_wafers mapping table to represent per-wafer entries for a queued file -->
    <changeSet id="6.1-create-sender-queue-wafers" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="sender_queue_wafers"/>
            </not>
        </preConditions>
        <createTable tableName="sender_queue_wafers">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="queue_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="lot" type="VARCHAR(255)"/>
            <column name="wafer" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <!-- Add foreign key to sender_queue(id) -->
        <addForeignKeyConstraint baseTableName="sender_queue_wafers"
                                 baseColumnNames="queue_id"
                                 constraintName="fk_sq_wafers_queue"
                                 referencedTableName="sender_queue"
                                 referencedColumnNames="id"/>
        <!-- Ensure per-queue uniqueness of wafer entries -->
        <addUniqueConstraint tableName="sender_queue_wafers"
                             columnNames="queue_id, wafer"
                             constraintName="uk_sender_queue_wafers"/>
        <!-- Helpful index for lookups by queue_id -->
        <createIndex tableName="sender_queue_wafers" indexName="idx_sq_wafers_queue">
            <column name="queue_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
