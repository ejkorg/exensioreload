<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Add additional fields to users table for Super Admin functionality -->
    <changeSet id="2025-02-01-01-enhance-users-table" author="super-admin-implementation">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="users"/>
        </preConditions>
        
        <!-- Add status column if it doesn't exist -->
        <addColumn tableName="users">
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        
        <!-- Add last_login_at column if it doesn't exist -->
        <addColumn tableName="users">
            <column name="last_login_at" type="TIMESTAMP"/>
        </addColumn>
        
        <!-- Add updated_at column if it doesn't exist -->
        <addColumn tableName="users">
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </addColumn>
        
        <addColumn tableName="users">
            <column name="created_by" type="BIGINT"/>
        </addColumn>
        
        <addColumn tableName="users">
            <column name="updated_by" type="BIGINT"/>
        </addColumn>
        
        <!-- Add check constraint for status -->
        <sql dbms="oracle">
            ALTER TABLE users ADD CONSTRAINT chk_users_status 
            CHECK (status IN ('ACTIVE', 'INACTIVE', 'LOCKED'))
        </sql>
        
        <sql dbms="postgresql,h2">
            ALTER TABLE users ADD CONSTRAINT chk_users_status 
            CHECK (status IN ('ACTIVE', 'INACTIVE', 'LOCKED'))
        </sql>
        
        <!-- Add foreign key constraints for audit fields -->
        <addForeignKeyConstraint baseTableName="users" baseColumnNames="created_by"
                                constraintName="fk_users_created_by"
                                referencedTableName="users" referencedColumnNames="id"/>
        
        <addForeignKeyConstraint baseTableName="users" baseColumnNames="updated_by"
                                constraintName="fk_users_updated_by"
                                referencedTableName="users" referencedColumnNames="id"/>
    </changeSet>

    <!-- Create audit_log table for comprehensive audit trail -->
    <changeSet id="2025-02-01-02-create-audit-log-table" author="super-admin-implementation">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="audit_log"/>
            </not>
        </preConditions>
        
        <createTable tableName="audit_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="resource_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="resource_id" type="VARCHAR(100)"/>
            <column name="details" type="TEXT"/>
            <column name="ip_address" type="VARCHAR(45)"/>
            <column name="user_agent" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Add foreign key constraint -->
        <addForeignKeyConstraint baseTableName="audit_log" baseColumnNames="user_id"
                                constraintName="fk_audit_user"
                                referencedTableName="users" referencedColumnNames="id"/>

        <!-- Add performance indexes -->
        <createIndex tableName="audit_log" indexName="idx_audit_log_user_action">
            <column name="user_id"/>
            <column name="action"/>
            <column name="created_at"/>
        </createIndex>

        <createIndex tableName="audit_log" indexName="idx_audit_log_resource">
            <column name="resource_type"/>
            <column name="resource_id"/>
            <column name="created_at"/>
        </createIndex>
        
        <createIndex tableName="audit_log" indexName="idx_audit_log_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!-- Add SUPER_ADMIN role to existing users who have ADMIN role -->
    <changeSet id="2025-02-01-03-add-super-admin-role" author="super-admin-implementation">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="user_roles"/>
        </preConditions>
        
        <!-- Insert SUPER_ADMIN role for existing ADMIN users -->
        <sql>
            INSERT INTO user_roles (user_id, role)
            SELECT DISTINCT user_id, 'SUPER_ADMIN'
            FROM user_roles 
            WHERE role = 'ADMIN'
            AND NOT EXISTS (
                SELECT 1 FROM user_roles ur2 
                WHERE ur2.user_id = user_roles.user_id 
                AND ur2.role = 'SUPER_ADMIN'
            )
        </sql>
    </changeSet>

    <!-- Oracle-specific timestamp adjustments - FIXED VERSION -->
    <changeSet id="2025-02-01-04-oracle-timestamps-fixed" author="super-admin-implementation">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <dbms type="oracle"/>
            <columnExists tableName="users" columnName="updated_at"/>
        </preConditions>
        
        <!-- Step 1: Add temporary columns with new data types -->
        <addColumn tableName="users">
            <column name="updated_at_new" type="TIMESTAMP(6) WITH TIME ZONE"/>
        </addColumn>
        
        <addColumn tableName="users">
            <column name="last_login_at_new" type="TIMESTAMP(6) WITH TIME ZONE"/>
        </addColumn>
        
        <!-- Step 2: Copy data from old columns to new columns -->
        <sql>
            UPDATE users SET 
                updated_at_new = CAST(updated_at AS TIMESTAMP(6) WITH TIME ZONE),
                last_login_at_new = CAST(last_login_at AS TIMESTAMP(6) WITH TIME ZONE)
            WHERE updated_at IS NOT NULL OR last_login_at IS NOT NULL
        </sql>
        
        <!-- Step 3: Drop old columns -->
        <dropColumn tableName="users" columnName="updated_at"/>
        <dropColumn tableName="users" columnName="last_login_at"/>
        
        <!-- Step 4: Rename new columns to original names -->
        <renameColumn tableName="users" oldColumnName="updated_at_new" newColumnName="updated_at"/>
        <renameColumn tableName="users" oldColumnName="last_login_at_new" newColumnName="last_login_at"/>
        
        <!-- Step 5: Add default values -->
        <addDefaultValue tableName="users" columnName="updated_at" defaultValueComputed="SYSTIMESTAMP"/>
    </changeSet>

    <!-- Oracle-specific adjustments for audit_log -->
    <changeSet id="2025-02-01-04b-oracle-audit-timestamps" author="super-admin-implementation">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <dbms type="oracle"/>
            <columnExists tableName="audit_log" columnName="created_at"/>
        </preConditions>
        
        <!-- Add temporary column -->
        <addColumn tableName="audit_log">
            <column name="created_at_new" type="TIMESTAMP(6) WITH TIME ZONE"/>
        </addColumn>
        
        <!-- Copy data -->
        <sql>
            UPDATE audit_log SET created_at_new = CAST(created_at AS TIMESTAMP(6) WITH TIME ZONE)
            WHERE created_at IS NOT NULL
        </sql>
        
        <!-- Drop old column and rename -->
        <dropColumn tableName="audit_log" columnName="created_at"/>
        <renameColumn tableName="audit_log" oldColumnName="created_at_new" newColumnName="created_at"/>
        
        <!-- Add default value -->
        <addDefaultValue tableName="audit_log" columnName="created_at" defaultValueComputed="SYSTIMESTAMP"/>
    </changeSet>

    <!-- Create password_history table for password policy enforcement -->
    <changeSet id="2025-02-01-05-create-password-history-table" author="super-admin-implementation">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="password_history"/>
            </not>
        </preConditions>
        
        <createTable tableName="password_history">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <addForeignKeyConstraint baseTableName="password_history" baseColumnNames="user_id"
                                constraintName="fk_password_history_user"
                                referencedTableName="users" referencedColumnNames="id"
                                onDelete="CASCADE"/>
        
        <createIndex tableName="password_history" indexName="idx_password_history_user_created">
            <column name="user_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!-- Create user_sessions table for session management -->
    <changeSet id="2025-02-01-06-create-user-sessions-table" author="super-admin-implementation">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="user_sessions"/>
            </not>
        </preConditions>
        
        <createTable tableName="user_sessions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="session_token" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="ip_address" type="VARCHAR(45)"/>
            <column name="user_agent" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_accessed_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <addForeignKeyConstraint baseTableName="user_sessions" baseColumnNames="user_id"
                                constraintName="fk_user_sessions_user"
                                referencedTableName="users" referencedColumnNames="id"
                                onDelete="CASCADE"/>
        
        <!-- Create indexes moved to a dedicated changeSet to keep preConditions at the start of a changeSet -->
    </changeSet>

    <!-- ChangeSet to create user_sessions user index if missing -->
    <changeSet id="2025-02-01-06a-create-user-sessions-user-index" author="super-admin-implementation">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="user_sessions"/>
            <not>
                <indexExists tableName="user_sessions" indexName="idx_user_sessions_user"/>
            </not>
        </preConditions>
        <createIndex tableName="user_sessions" indexName="idx_user_sessions_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <!-- Separate changeset for session_token index (may already exist due to unique constraint) -->
    <changeSet id="2025-02-01-06b-create-user-sessions-token-index" author="super-admin-implementation">
        <!-- Only create the index if no index exists on the column.
             Oracle: check USER_IND_COLUMNS for an index on SESSION_TOKEN.
             PostgreSQL: the unique constraint auto-creates user_sessions_session_token_key. -->
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="user_sessions"/>
            <or>
                <and>
                    <dbms type="oracle"/>
                    <sqlCheck expectedResult="0">
                        SELECT COUNT(*) FROM user_ind_columns WHERE table_name = 'USER_SESSIONS' AND column_name = 'SESSION_TOKEN'
                    </sqlCheck>
                </and>
                <and>
                    <not>
                        <dbms type="oracle"/>
                    </not>
                    <not>
                        <indexExists tableName="user_sessions" indexName="user_sessions_session_token_key"/>
                    </not>
                </and>
            </or>
        </preConditions>

        <createIndex tableName="user_sessions" indexName="idx_user_sessions_token">
            <column name="session_token"/>
        </createIndex>
    </changeSet>

    <!-- Separate changeset for expires_at index -->
    <changeSet id="2025-02-01-06c-create-user-sessions-expires-index" author="super-admin-implementation">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="user_sessions"/>
            <not>
                <indexExists tableName="user_sessions" indexName="idx_user_sessions_expires"/>
            </not>
        </preConditions>
        
        <createIndex tableName="user_sessions" indexName="idx_user_sessions_expires">
            <column name="expires_at"/>
        </createIndex>
    </changeSet>

    <!-- Oracle-specific adjustments for new tables -->
    <changeSet id="2025-02-01-07-oracle-new-table-timestamps" author="super-admin-implementation">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <dbms type="oracle"/>
        </preConditions>
        
        <!-- For new tables, we can directly create with the right types -->
        <modifyDataType tableName="password_history" columnName="created_at" newDataType="TIMESTAMP(6) WITH TIME ZONE"/>
        <modifyDataType tableName="user_sessions" columnName="created_at" newDataType="TIMESTAMP(6) WITH TIME ZONE"/>
        <modifyDataType tableName="user_sessions" columnName="last_accessed_at" newDataType="TIMESTAMP(6) WITH TIME ZONE"/>
        <modifyDataType tableName="user_sessions" columnName="expires_at" newDataType="TIMESTAMP(6) WITH TIME ZONE"/>
        
        <addDefaultValue tableName="password_history" columnName="created_at" defaultValueComputed="SYSTIMESTAMP"/>
        <addDefaultValue tableName="user_sessions" columnName="created_at" defaultValueComputed="SYSTIMESTAMP"/>
        <addDefaultValue tableName="user_sessions" columnName="last_accessed_at" defaultValueComputed="SYSTIMESTAMP"/>
    </changeSet>

</databaseChangeLog>