<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Create config_pipeline table -->
    <changeSet id="14.0-create-config-pipeline-table" author="exensioreload">
        <comment>Create config_pipeline table for storing ETL pipeline configurations</comment>
        <createTable tableName="config_pipeline">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="pipeline_key" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="site" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="server" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="socket_port" type="INTEGER">
                <constraints nullable="false" />
            </column>
            <column name="config_name" type="VARCHAR(255)" />
            <column name="sender_id" type="INTEGER">
                <constraints nullable="false" />
            </column>
            <column name="rerun_period_minutes" type="INTEGER">
                <constraints nullable="false" />
            </column>
            <column name="environment" type="VARCHAR(10)">
                <constraints nullable="false" />
            </column>
            <column name="enabled" type="BOOLEAN">
                <constraints nullable="false" />
                <defaultValue>true</defaultValue>
            </column>
            <column name="historical_mode_enabled" type="BOOLEAN">
                <constraints nullable="false" />
                <defaultValue>false</defaultValue>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" />
            <column name="created_by" type="BIGINT" />
            <column name="updated_by" type="BIGINT" />
        </createTable>

        <createIndex indexName="idx_pipeline_site" tableName="config_pipeline">
            <column name="site" />
        </createIndex>

        <createIndex indexName="idx_pipeline_environment" tableName="config_pipeline">
            <column name="environment" />
        </createIndex>

        <createIndex indexName="idx_pipeline_sender" tableName="config_pipeline">
            <column name="sender_id" />
        </createIndex>

        <createIndex indexName="idx_pipeline_site_historical" tableName="config_pipeline">
            <column name="site" />
            <column name="historical_mode_enabled" />
        </createIndex>
    </changeSet>

    <!-- Create config_pipeline_stage table -->
    <changeSet id="14.0-create-config-pipeline-stage-table" author="exensioreload">
        <comment>Create config_pipeline_stage table for storing pipeline stages with dependencies</comment>
        <createTable tableName="config_pipeline_stage">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="pipeline_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_stage_pipeline" references="config_pipeline(id)" />
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="type" type="VARCHAR(20)">
                <constraints nullable="false" />
            </column>
            <column name="timeout_minutes" type="INTEGER">
                <constraints nullable="false" />
            </column>
            <column name="execution_order" type="INTEGER">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createIndex indexName="idx_stage_pipeline" tableName="config_pipeline_stage">
            <column name="pipeline_id" />
        </createIndex>
    </changeSet>

    <!-- Create config_stage_dependency table -->
    <changeSet id="14.0-create-config-stage-dependency-table" author="exensioreload">
        <comment>Create config_stage_dependency table for storing stage dependencies</comment>
        <createTable tableName="config_stage_dependency">
            <column name="stage_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_dependency_stage" references="config_pipeline_stage(id)" />
            </column>
            <column name="depends_on" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
        </createTable>

        <addPrimaryKey tableName="config_stage_dependency" columnNames="stage_id,depends_on" />

        <createIndex indexName="idx_dependency_stage" tableName="config_stage_dependency">
            <column name="stage_id" />
        </createIndex>
    </changeSet>

    <!-- Create config_etl_server table -->
    <changeSet id="14.0-create-config-etl-server-table" author="exensioreload">
        <comment>Create config_etl_server table for storing ETL server configurations</comment>
        <createTable tableName="config_etl_server">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="server_key" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="host" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="ssh_port" type="INTEGER">
                <constraints nullable="false" />
            </column>
            <column name="socket_port" type="INTEGER">
                <constraints nullable="false" />
            </column>
            <column name="user" type="VARCHAR(100)">
                <constraints nullable="false" />
            </column>
            <column name="encrypted_password" type="VARCHAR(500)">
                <constraints nullable="false" />
            </column>
            <column name="timeout_ms" type="INTEGER">
                <constraints nullable="false" />
            </column>
            <column name="environment" type="VARCHAR(10)">
                <constraints nullable="false" />
            </column>
            <column name="enabled" type="BOOLEAN">
                <constraints nullable="false" />
                <defaultValue>true</defaultValue>
            </column>
            <column name="is_historical_sender" type="BOOLEAN">
                <constraints nullable="false" />
                <defaultValue>false</defaultValue>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" />
            <column name="created_by" type="BIGINT" />
            <column name="updated_by" type="BIGINT" />
        </createTable>

        <createIndex indexName="idx_etl_server_key" tableName="config_etl_server">
            <column name="server_key" />
        </createIndex>

        <createIndex indexName="idx_etl_server_environment" tableName="config_etl_server">
            <column name="environment" />
        </createIndex>

        <createIndex indexName="idx_etl_server_historical" tableName="config_etl_server">
            <column name="is_historical_sender" />
        </createIndex>
    </changeSet>

    <!-- Create config_db_connection table -->
    <changeSet id="14.0-create-config-db-connection-table" author="exensioreload">
        <comment>Create config_db_connection table for storing database connection configurations</comment>
        <createTable tableName="config_db_connection">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="connection_key" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="db_type" type="VARCHAR(20)">
                <constraints nullable="false" />
            </column>
            <column name="schema" type="VARCHAR(100)">
                <constraints nullable="false" />
            </column>
            <column name="host" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="user" type="VARCHAR(100)">
                <constraints nullable="false" />
            </column>
            <column name="encrypted_password" type="VARCHAR(500)">
                <constraints nullable="false" />
            </column>
            <column name="connection_timeout_ms" type="INTEGER">
                <constraints nullable="false" />
            </column>
            <column name="maximum_pool_size" type="INTEGER">
                <constraints nullable="false" />
            </column>
            <column name="minimum_idle" type="INTEGER">
                <constraints nullable="false" />
            </column>
            <column name="download_url" type="VARCHAR(500)" />
            <column name="environment" type="VARCHAR(10)">
                <constraints nullable="false" />
            </column>
            <column name="enabled" type="BOOLEAN">
                <constraints nullable="false" />
                <defaultValue>true</defaultValue>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" />
            <column name="created_by" type="BIGINT" />
            <column name="updated_by" type="BIGINT" />
        </createTable>

        <createIndex indexName="idx_db_connection_key" tableName="config_db_connection">
            <column name="connection_key" />
        </createIndex>

        <createIndex indexName="idx_db_connection_environment" tableName="config_db_connection">
            <column name="environment" />
        </createIndex>
    </changeSet>

    <!-- Enhance audit_log table with new columns -->
    <changeSet id="14.0-enhance-audit-log-table" author="exensioreload">
        <comment>Enhance audit_log table with status and error_message columns</comment>
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="audit_log" />
                <not>
                    <columnExists tableName="audit_log" columnName="status" />
                </not>
            </and>
        </preConditions>
        <addColumn tableName="audit_log">
            <column name="status" type="VARCHAR(20)" />
            <column name="error_message" type="VARCHAR(1000)" />
        </addColumn>
    </changeSet>

    <!-- Add indexes to audit_log for performance -->
    <changeSet id="14.0-create-audit-log-indexes" author="exensioreload">
        <comment>Create indexes on audit_log table for improved query performance</comment>
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="audit_log" />
                <not>
                    <indexExists tableName="audit_log" indexName="idx_audit_user_created" />
                </not>
            </and>
        </preConditions>
        <createIndex indexName="idx_audit_user_created" tableName="audit_log">
            <column name="user_id" />
            <column name="created_at" />
        </createIndex>

        <createIndex indexName="idx_audit_resource" tableName="audit_log">
            <column name="resource_type" />
            <column name="resource_id" />
        </createIndex>

        <createIndex indexName="idx_audit_action" tableName="audit_log">
            <column name="action" />
        </createIndex>

        <createIndex indexName="idx_audit_created" tableName="audit_log">
            <column name="created_at" />
        </createIndex>
    </changeSet>

</databaseChangeLog>
