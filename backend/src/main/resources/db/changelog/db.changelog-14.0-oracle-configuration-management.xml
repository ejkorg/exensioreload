<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Create config_pipeline table for Oracle -->
    <changeSet id="14.0-oracle-create-config-pipeline-table" author="exensioreload" dbms="oracle">
        <comment>Create config_pipeline table for storing ETL pipeline configurations (Oracle syntax)</comment>
        <createSequence sequenceName="config_pipeline_id_seq" />
        <createTable tableName="config_pipeline">
            <column name="id" type="NUMBER(19,0)">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="pipeline_key" type="VARCHAR2(100)">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="site" type="VARCHAR2(50)">
                <constraints nullable="false" />
            </column>
            <column name="server" type="VARCHAR2(50)">
                <constraints nullable="false" />
            </column>
            <column name="socket_port" type="NUMBER(10,0)">
                <constraints nullable="false" />
            </column>
            <column name="config_name" type="VARCHAR2(255)" />
            <column name="sender_id" type="NUMBER(10,0)">
                <constraints nullable="false" />
            </column>
            <column name="rerun_period_minutes" type="NUMBER(10,0)">
                <constraints nullable="false" />
            </column>
            <column name="environment" type="VARCHAR2(10)">
                <constraints nullable="false" />
            </column>
            <column name="enabled" type="NUMBER(1,0)">
                <constraints nullable="false" />
                <defaultValue>1</defaultValue>
            </column>
            <column name="historical_mode_enabled" type="NUMBER(1,0)">
                <constraints nullable="false" />
                <defaultValue>0</defaultValue>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" />
            <column name="created_by" type="NUMBER(19,0)" />
            <column name="updated_by" type="NUMBER(19,0)" />
        </createTable>

        <createIndex indexName="idx_pipeline_site" tableName="config_pipeline">
            <column name="site" />
        </createIndex>

        <createIndex indexName="idx_pipeline_environment" tableName="config_pipeline">
            <column name="environment" />
        </createIndex>

        <createIndex indexName="idx_pipeline_sender" tableName="config_pipeline">
            <column name="sender_id" />
        </createIndex>

        <createIndex indexName="idx_pipeline_site_historical" tableName="config_pipeline">
            <column name="site" />
            <column name="historical_mode_enabled" />
        </createIndex>
    </changeSet>

    <!-- Create trigger for config_pipeline ID generation -->
    <changeSet id="14.0-oracle-create-config-pipeline-trigger" author="exensioreload" dbms="oracle">
        <comment>Create trigger for config_pipeline ID generation</comment>
        <sql>
            CREATE TRIGGER config_pipeline_id_trigger
            BEFORE INSERT ON config_pipeline
            FOR EACH ROW
            BEGIN
              SELECT config_pipeline_id_seq.NEXTVAL INTO :NEW.id FROM DUAL;
            END;
            /
        </sql>
    </changeSet>

    <!-- Create config_pipeline_stage table for Oracle -->
    <changeSet id="14.0-oracle-create-config-pipeline-stage-table" author="exensioreload" dbms="oracle">
        <comment>Create config_pipeline_stage table for storing pipeline stages with dependencies (Oracle syntax)</comment>
        <createSequence sequenceName="config_pipeline_stage_id_seq" />
        <createTable tableName="config_pipeline_stage">
            <column name="id" type="NUMBER(19,0)">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="pipeline_id" type="NUMBER(19,0)">
                <constraints nullable="false" foreignKeyName="fk_stage_pipeline" references="config_pipeline(id)" />
            </column>
            <column name="name" type="VARCHAR2(50)">
                <constraints nullable="false" />
            </column>
            <column name="type" type="VARCHAR2(20)">
                <constraints nullable="false" />
            </column>
            <column name="timeout_minutes" type="NUMBER(10,0)">
                <constraints nullable="false" />
            </column>
            <column name="execution_order" type="NUMBER(10,0)">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createIndex indexName="idx_stage_pipeline" tableName="config_pipeline_stage">
            <column name="pipeline_id" />
        </createIndex>
    </changeSet>

    <!-- Create trigger for config_pipeline_stage ID generation -->
    <changeSet id="14.0-oracle-create-config-pipeline-stage-trigger" author="exensioreload" dbms="oracle">
        <comment>Create trigger for config_pipeline_stage ID generation</comment>
        <sql>
            CREATE TRIGGER config_pipeline_stage_id_trigger
            BEFORE INSERT ON config_pipeline_stage
            FOR EACH ROW
            BEGIN
              SELECT config_pipeline_stage_id_seq.NEXTVAL INTO :NEW.id FROM DUAL;
            END;
            /
        </sql>
    </changeSet>

    <!-- Create config_stage_dependency table for Oracle -->
    <changeSet id="14.0-oracle-create-config-stage-dependency-table" author="exensioreload" dbms="oracle">
        <comment>Create config_stage_dependency table for storing stage dependencies (Oracle syntax)</comment>
        <createTable tableName="config_stage_dependency">
            <column name="stage_id" type="NUMBER(19,0)">
                <constraints nullable="false" foreignKeyName="fk_dependency_stage" references="config_pipeline_stage(id)" />
            </column>
            <column name="depends_on" type="VARCHAR2(50)">
                <constraints nullable="false" />
            </column>
        </createTable>

        <addPrimaryKey tableName="config_stage_dependency" columnNames="stage_id,depends_on" />

        <createIndex indexName="idx_dependency_stage" tableName="config_stage_dependency">
            <column name="stage_id" />
        </createIndex>
    </changeSet>

    <!-- Create config_etl_server table for Oracle -->
    <changeSet id="14.0-oracle-create-config-etl-server-table" author="exensioreload" dbms="oracle">
        <comment>Create config_etl_server table for storing ETL server configurations (Oracle syntax)</comment>
        <createSequence sequenceName="config_etl_server_id_seq" />
        <createTable tableName="config_etl_server">
            <column name="id" type="NUMBER(19,0)">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="server_key" type="VARCHAR2(100)">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="host" type="VARCHAR2(255)">
                <constraints nullable="false" />
            </column>
            <column name="ssh_port" type="NUMBER(10,0)">
                <constraints nullable="false" />
            </column>
            <column name="socket_port" type="NUMBER(10,0)">
                <constraints nullable="false" />
            </column>
            <column name="user" type="VARCHAR2(100)">
                <constraints nullable="false" />
            </column>
            <column name="encrypted_password" type="VARCHAR2(500)">
                <constraints nullable="false" />
            </column>
            <column name="timeout_ms" type="NUMBER(10,0)">
                <constraints nullable="false" />
            </column>
            <column name="environment" type="VARCHAR2(10)">
                <constraints nullable="false" />
            </column>
            <column name="enabled" type="NUMBER(1,0)">
                <constraints nullable="false" />
                <defaultValue>1</defaultValue>
            </column>
            <column name="is_historical_sender" type="NUMBER(1,0)">
                <constraints nullable="false" />
                <defaultValue>0</defaultValue>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" />
            <column name="created_by" type="NUMBER(19,0)" />
            <column name="updated_by" type="NUMBER(19,0)" />
        </createTable>

        <createIndex indexName="idx_etl_server_key" tableName="config_etl_server">
            <column name="server_key" />
        </createIndex>

        <createIndex indexName="idx_etl_server_environment" tableName="config_etl_server">
            <column name="environment" />
        </createIndex>

        <createIndex indexName="idx_etl_server_historical" tableName="config_etl_server">
            <column name="is_historical_sender" />
        </createIndex>
    </changeSet>

    <!-- Create trigger for config_etl_server ID generation -->
    <changeSet id="14.0-oracle-create-config-etl-server-trigger" author="exensioreload" dbms="oracle">
        <comment>Create trigger for config_etl_server ID generation</comment>
        <sql>
            CREATE TRIGGER config_etl_server_id_trigger
            BEFORE INSERT ON config_etl_server
            FOR EACH ROW
            BEGIN
              SELECT config_etl_server_id_seq.NEXTVAL INTO :NEW.id FROM DUAL;
            END;
            /
        </sql>
    </changeSet>

    <!-- Create config_db_connection table for Oracle -->
    <changeSet id="14.0-oracle-create-config-db-connection-table" author="exensioreload" dbms="oracle">
        <comment>Create config_db_connection table for storing database connection configurations (Oracle syntax)</comment>
        <createSequence sequenceName="config_db_connection_id_seq" />
        <createTable tableName="config_db_connection">
            <column name="id" type="NUMBER(19,0)">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="connection_key" type="VARCHAR2(100)">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="db_type" type="VARCHAR2(20)">
                <constraints nullable="false" />
            </column>
            <column name="schema" type="VARCHAR2(100)">
                <constraints nullable="false" />
            </column>
            <column name="host" type="VARCHAR2(255)">
                <constraints nullable="false" />
            </column>
            <column name="user" type="VARCHAR2(100)">
                <constraints nullable="false" />
            </column>
            <column name="encrypted_password" type="VARCHAR2(500)">
                <constraints nullable="false" />
            </column>
            <column name="connection_timeout_ms" type="NUMBER(10,0)">
                <constraints nullable="false" />
            </column>
            <column name="maximum_pool_size" type="NUMBER(10,0)">
                <constraints nullable="false" />
            </column>
            <column name="minimum_idle" type="NUMBER(10,0)">
                <constraints nullable="false" />
            </column>
            <column name="download_url" type="VARCHAR2(500)" />
            <column name="environment" type="VARCHAR2(10)">
                <constraints nullable="false" />
            </column>
            <column name="enabled" type="NUMBER(1,0)">
                <constraints nullable="false" />
                <defaultValue>1</defaultValue>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" />
            <column name="created_by" type="NUMBER(19,0)" />
            <column name="updated_by" type="NUMBER(19,0)" />
        </createTable>

        <createIndex indexName="idx_db_connection_key" tableName="config_db_connection">
            <column name="connection_key" />
        </createIndex>

        <createIndex indexName="idx_db_connection_environment" tableName="config_db_connection">
            <column name="environment" />
        </createIndex>
    </changeSet>

    <!-- Create trigger for config_db_connection ID generation -->
    <changeSet id="14.0-oracle-create-config-db-connection-trigger" author="exensioreload" dbms="oracle">
        <comment>Create trigger for config_db_connection ID generation</comment>
        <sql>
            CREATE TRIGGER config_db_connection_id_trigger
            BEFORE INSERT ON config_db_connection
            FOR EACH ROW
            BEGIN
              SELECT config_db_connection_id_seq.NEXTVAL INTO :NEW.id FROM DUAL;
            END;
            /
        </sql>
    </changeSet>

    <!-- Enhance audit_log table for Oracle -->
    <changeSet id="14.0-oracle-enhance-audit-log-table" author="exensioreload" dbms="oracle">
        <comment>Enhance audit_log table with status and error_message columns (Oracle syntax)</comment>
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="audit_log" />
                <not>
                    <columnExists tableName="audit_log" columnName="status" />
                </not>
            </and>
        </preConditions>
        <addColumn tableName="audit_log">
            <column name="status" type="VARCHAR2(20)" />
            <column name="error_message" type="VARCHAR2(1000)" />
        </addColumn>
    </changeSet>

    <!-- Add indexes to audit_log for Oracle -->
    <changeSet id="14.0-oracle-create-audit-log-indexes" author="exensioreload" dbms="oracle">
        <comment>Create indexes on audit_log table for improved query performance (Oracle syntax)</comment>
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="audit_log" />
                <not>
                    <indexExists tableName="audit_log" indexName="idx_audit_user_created" />
                </not>
            </and>
        </preConditions>
        <createIndex indexName="idx_audit_user_created" tableName="audit_log">
            <column name="user_id" />
            <column name="created_at" />
        </createIndex>

        <createIndex indexName="idx_audit_resource" tableName="audit_log">
            <column name="resource_type" />
            <column name="resource_id" />
        </createIndex>

        <createIndex indexName="idx_audit_action" tableName="audit_log">
            <column name="action" />
        </createIndex>

        <createIndex indexName="idx_audit_created" tableName="audit_log">
            <column name="created_at" />
        </createIndex>
    </changeSet>

</databaseChangeLog>
