[Unit]
Description=Exensio Reload Service
Documentation=https://github.com/your-org/exensioreload
After=network.target postgresql.service oracle.service

[Service]
Type=simple
User=exensio
Group=exensio
WorkingDirectory=/opt/exensioreload

# CRITICAL: Force JVM to use UTC timezone for consistent timestamp handling
# This ensures Oracle TIMESTAMP columns, Elasticsearch @timestamp, and Java Instant
# all use the same timezone reference, preventing query mismatches.
Environment="JAVA_OPTS=-Duser.timezone=UTC -Xmx2g -Xms512m -XX:+UseG1GC"

# Application configuration via environment variables
Environment="SPRING_PROFILES_ACTIVE=production"
# IMPORTANT: CP_ES_URL should be the BASE URL only (e.g., https://elasticsearch:9200)
# DO NOT include the index pattern or /_search endpoint - the backend will add these automatically
Environment="CP_ES_URL=https://your-elasticsearch:9200"
Environment="CP_ES_API_KEY=your-api-key-here"
# OR use basic auth instead of API key:
# Environment="CP_ES_USERNAME=your-username"
# Environment="CP_ES_PASSWORD=your-password"

# Exensio integration (set EXENSIO_ENABLED=true to activate)
Environment="EXENSIO_ENABLED=true"
Environment="EXENSIO_ENV=PROD"
Environment="EXENSIO_PROD_URL=https://your-exensio-api:8080/api"
Environment="EXENSIO_USERNAME=your-username"
Environment="EXENSIO_PASSWORD=your-password"

# Optional: Set OS timezone as well (defense in depth)
Environment="TZ=UTC"

ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/exensioreload/exensioreload.jar

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitBurst=3
StartLimitInterval=60

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/exensioreload/logs

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=exensioreload

[Install]
WantedBy=multi-user.target
