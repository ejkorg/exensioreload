<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Drop legacy 4-column unique constraint -->
    <changeSet id="6.0-drop-legacy-constraint-v4" author="copilot">
        <validCheckSum>ANY</validCheckSum>
        <sql dbms="oracle" splitStatements="false" endDelimiter="/">
BEGIN
    EXECUTE IMMEDIATE 'ALTER TABLE SENDER_STAGE DROP CONSTRAINT UK_SENDER_STAGE_SITE_PAYLOAD';
EXCEPTION
    WHEN OTHERS THEN NULL;
END;
/
        </sql>
    </changeSet>

    <!-- Drop legacy index if it exists (constraint may have already been dropped) -->
    <changeSet id="6.0-drop-legacy-constraint-v3" author="copilot">
        <validCheckSum>ANY</validCheckSum>
        <sql dbms="oracle" splitStatements="false" endDelimiter="/">
BEGIN
    EXECUTE IMMEDIATE 'DROP INDEX UK_SENDER_STAGE_SITE_PAYLOAD';
EXCEPTION
    WHEN OTHERS THEN NULL;
END;
/
        </sql>
    </changeSet>

    <!-- Add new unique constraint including lot and wafer -->
    <changeSet id="6.0-add-stage-unique-constraint-with-lot-wafer" author="copilot">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="SENDER_STAGE" />
                <columnExists tableName="SENDER_STAGE" columnName="site"/>
                <columnExists tableName="SENDER_STAGE" columnName="sender_id"/>
                <columnExists tableName="SENDER_STAGE" columnName="metadata_id"/>
                <columnExists tableName="SENDER_STAGE" columnName="data_id"/>
                <columnExists tableName="SENDER_STAGE" columnName="lot"/>
                <columnExists tableName="SENDER_STAGE" columnName="wafer"/>
                <not>
                    <or>
                        <!-- Oracle check -->
                        <and>
                            <dbms type="oracle"/>
                            <sqlCheck expectedResult="1">
                                SELECT COUNT(*) FROM user_constraints 
                                WHERE constraint_name IN ('UK_STAGE_UNIQUE', 'uk_stage_unique')
                                AND constraint_type = 'U'
                            </sqlCheck>
                        </and>
                        <!-- H2 / PostgreSQL check -->
                        <and>
                            <not><dbms type="oracle"/></not>
                            <or>
                                <indexExists tableName="SENDER_STAGE" indexName="UK_STAGE_UNIQUE"/>
                                <indexExists tableName="SENDER_STAGE" indexName="uk_stage_unique"/>
                            </or>
                        </and>
                    </or>
                </not>
            </and>
        </preConditions>
        <addUniqueConstraint tableName="SENDER_STAGE" 
                             columnNames="site, sender_id, metadata_id, data_id, lot, wafer" 
                             constraintName="UK_STAGE_UNIQUE"/>
        <rollback>
            <dropUniqueConstraint tableName="SENDER_STAGE" constraintName="UK_STAGE_UNIQUE"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
