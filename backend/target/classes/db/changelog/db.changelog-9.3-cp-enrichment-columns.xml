<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Add nullable cp_output_path column to SENDER_STAGE -->
    <changeSet id="9.3-add-cp-output-path" author="kiro">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="SENDER_STAGE"/>
                <not>
                    <columnExists tableName="SENDER_STAGE" columnName="cp_output_path"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="SENDER_STAGE">
            <column name="cp_output_path" type="VARCHAR2(1000)"/>
        </addColumn>
    </changeSet>

    <!-- Add nullable cp_output_target column to SENDER_STAGE -->
    <changeSet id="9.3-add-cp-output-target" author="kiro">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="SENDER_STAGE"/>
                <not>
                    <columnExists tableName="SENDER_STAGE" columnName="cp_output_target"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="SENDER_STAGE">
            <column name="cp_output_target" type="VARCHAR2(20)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
