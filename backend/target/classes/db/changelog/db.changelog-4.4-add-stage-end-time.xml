<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Add nullable end_time to staging table; safe to re-run via preconditions. -->
    <changeSet id="4.4-add-stage-end-time" author="copilot">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="SENDER_STAGE" />
                <not>
                    <columnExists tableName="SENDER_STAGE" columnName="end_time" />
                </not>
            </and>
        </preConditions>
        <addColumn tableName="SENDER_STAGE">
            <column name="end_time" type="TIMESTAMP" />
        </addColumn>
    </changeSet>

</databaseChangeLog>
