// Filename: cz2-defect-fmt.fmt (14-klarf_18_Si.fmt)
//
// Purpose: Format file for KLARF 1.8 defect files — CZ2 variant
//
// CHANGEOG:
// Nov-23-2023 : updated to load roughbin as manualclass if manualclass is zero
// Aug-15-2025 : update DiePitch, add DelSep before reading and AddSep after.
//               This is to resolve the issue on incorrect die_wd and die_ht
// Jun-01-2026 : REFACTORED — complete rewrite incorporating all bk-defect-fmt.fmt
//               fixes plus cz2-specific features and multi-wafer support.
//
//   Fixes applied from bk-defect-fmt.fmt:
//     1. [CRITICAL] IMAGEINFO/POLARITY crash — image list consumption moved into
//        IMAGEINFO handler; POLARITY reads into temp variable, only sets img_cnt
//        when do_imagelist is FALSE. SkipWords(1) per image entry (was 2).
//     2. [HIGH]     Item[30] -> Item[100] — prevents array overflow on wide KLARF.
//     3. [MEDIUM]   TestSummaryList types — haze_reg/avg/std/med/peak and
//        areapertest changed from integer to real; GetInt -> GetReal.
//     4. [MEDIUM]   NotEndOfFile guard added to defect record loop.
//     5. [LOW]      Dead duplicate IMAGEINFO handler removed.
//     6. [LOW]      GoToBOF + GoTo("WaferRecord") removed before DefectList;
//        forward-only GoTo("DefectList") used instead.
//
//   Additional fixes in this refactor:
//     7. [MEDIUM]   Multi-wafer support — all GoToBOF removed from inside the
//        record loop. Forward-only GoTo("WaferRecord") positions to each record,
//        then forward-only GoTo for AreaPerTest, SampleCenterLocation, DieOrigin,
//        DefectList, TestSummaryList (all appear in order within each WaferRecord).
//     8. [MEDIUM]   DefectRecordSpec parser — else branch no longer does
//        SkipWords(-1), so unknown column types are consumed harmlessly instead
//        of being misinterpreted as column names.
//     9. [LOW]      Added section separator comments for maintainability.
//
//   CZ2-specific features preserved:
//     - ProbeProgramName metadata -> vProgramName (used in program name construction)
//     - Facility attribute key (not TestFacility) -> vTestFacility
//     - ISO date format: "%Y/%m/%d %H:%M:%S"
//     - Program name prefers ProbeProgramName over DeviceID

SCRIPT klarf_18
CONST
    D = False
    DEBUG = 0
    PROGRAM_SUFFIX = "::K18"
VAR
    // ===================== Condition/Index/Result Declarations ==================
    TestName            string              Cond
    Unit                string              Cond
    TestNum             integer             KeyCond
    Wafer               string              KeyIndex
    Layer               string              Index
    res                 real                Result

    // ===================== General Working Variables ===========================
    wfid                integer
    str                 string
    HowManyRecords      integer
    record              integer
    counter             integer
    LotID_Str           string
    WaferID_Str         string
    Setup_Time_Str      string
    Results_Time_Str    string
    ProductID_Str       string
    StepID_Str          string
    wmap_name_str       string
    wf_size             real
    flat_type           char
    wf_units            string
    Flat_Type_Str       string
    cluster_die_wd      real
    cluster_die_ht      real
    die_wd              real
    die_ht              real
    center_x            real
    center_y            real
    wf_xcenter          real
    wf_ycenter          real
    line_str            string
    def_cnt             integer
    test_num            integer
    dd                  real
    insp_die            integer
    def_die             integer
    major_axis          real
    minor_axis          real
    el_orient           real
    num                 integer
    Class_Str           string
    df_index            integer
    xInd                integer
    yInd                integer
    xPos                real
    yPos                real
    x_size              real
    y_size              real
    df_area             real
    df_size             real
    manualclass         integer
    finebin             integer
    roughbin            integer
    cluster             integer
    bin                 integer
    pos_type            integer
    wafer_type          integer
    intensity           integer
    tmpvar              integer
    slot_num            integer
    Flat_Location_Str   string
    flat_location       char
    test_area           real
    SrcLotID_Str        string
    IsProgNew           boolean

    // Defect column parsing flags
    do_imagelist        boolean
    do_cluster          boolean
    do_roughbin         boolean
    do_finebin          boolean
    do_review           boolean
    do_autosem          boolean
    do_mansem           boolean
    do_confidence       boolean
    do_cn_conf          boolean

    // Limit/bin variables
    LowerLimit          real
    UpperLimit          real
    LowerLimit_Str      string
    UpperLimit_Str      string
    fld_rows            integer
    fld_cols            integer
    row_offset          integer
    col_offset          integer

    // Die map arrays
    diex[10000]         integer
    diey[10000]         integer
    dieType[10000]      char

    // Equipment/program strings
    Tester_Str          string
    TesterType_Str      string
    tech_Str            string
    proc_Str            string
    Prog_Str            string
    size_type           integer
    DD_Threshold        real
    DC_Threshold        integer

    // Image variables
    img_list            integer
    img_indx            integer
    img_file            string
    img_path            string
    review              integer
    shift               integer
    dieCnt              integer
    j                   integer
    Item[100]           string
    ItemNum             integer
    img_cnt             integer
    autosem             integer
    mansem              integer
    confidence          real
    cn_conf             real
    imgArr[10]          integer
    imgFileArr[10]      string
    k                   integer
    multiTiffFiles      boolean
    xPosDir             Char
    cols_cnt            integer

    // FIX #3: TestSummaryList fields — changed from integer to real
    haze_reg            real
    haze_avg            real
    haze_std            real
    haze_med            real
    haze_peak           real
    areapertest         real

    // ===================== Metadata Variables ===================================
    vArea               string
    vDataFileName       string
    vAlternateProduct   string
    vFab                string
    vLotID              string
    vLotType            string
    vProcess            string
    vProduct            string
    vProgramName        string
    vPTI2               string
    vRecipe             string
    vResultTime         string
    vSlot               string
    vSourceLot          string
    vStartTime          string
    vStepId             string
    vTechnology         string
    vTesterId           string
    vTesterType         string
    vWaferID            string
    vWaferNumber        string
    vTestFacility       string
    vTestFloor          string
    vAttributeValue     String
    vAttributeSource    String
    vAttributeName      String
    vRetestCode         String
    vSampleSize         String

    // Attribute parsing state
    Attribute_tag       boolean
    EndOfAttributes     Boolean
    Metadata_tag        boolean
    Basket              string

    // Program name construction
    DpProgram_Str       string
    SourceLot_Str       string
    programPrefix       string
    defectListCount     integer
    defectListColNameArray[100]   string
    defectListColValueArray[100]  string
    PTRN_Str            string
    programSuffix       string
    fabIdFromFile       string
    unitDivisor         integer
    unitMultiplier      integer
    charCounter         integer
    i                   integer

BEGIN

    // =========================================================================
    //                     SECTION 1: METADATA PARSING
    // =========================================================================

    AddSep(' ')
    AddSep('=')
    AddSep('>')

    programPrefix = Argument
    programPrefix = StrCat(programPrefix, "_")
    programSuffix = PROGRAM_SUFFIX

    GoTo("<Metadata")
    If ErrorCode <> 0
        ExitScript("Missing METADATA section.")
    End If

    SkipWords(-1)
    Basket = GetWord

    If Basket = "<Metadata"
        Metadata_tag = True
        Attribute_tag = False
    End If

    While Metadata_tag
        Basket = GetWord
        If Basket = "</Metadata"
            Metadata_tag = False
        Else If Basket = "<Attribute"
            Attribute_tag = True
            vAttributeValue = ""
            vAttributeSource = ""
            vAttributeName = ""
            EndOfAttributes = False

            While Not EndOfAttributes
                Basket = GetWord
                If Basket = "Value"
                    vAttributeValue = GetQuotedWord('"')
                    If((vAttributeValue = "N/A") OR (vAttributeValue = "") OR (vAttributeValue = "DUMMY_TYPE") OR (vAttributeValue = "NA") OR (vAttributeValue = "Dummy_Type"))
                        vAttributeValue = "NA"
                    End If
                Else If Basket = "Source"
                    vAttributeSource = GetQuotedWord('"')
                Else If Basket = "Name"
                    vAttributeName = GetQuotedWord('"')
                Else If Basket = "</Attribute"
                    EndOfAttributes = True
                Else If Basket = "/"
                    EndOfAttributes = True
                End If
            End While

            If DEBUG = 8
                Print("Name=", vAttributeName, " Value=", vAttributeValue, " Source=", vAttributeSource, 'NL')
            End If

            If vAttributeName = "ProbeProgramName"
                vProgramName = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "Area"
                vArea = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "DataFileName"
                vDataFileName = vAttributeValue
            End If
            If vAttributeName = "AlternateProduct"
                vAlternateProduct = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "Fab"
                vFab = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "LotId"
                vLotID = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "LotType"
                vLotType = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "Process"
                vProcess = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "Product"
                vProduct = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "Pti2"
                vPTI2 = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "Recipe"
                vRecipe = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "ResultTime"
                vResultTime = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "Slot"
                vSlot = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "SourceLot"
                vSourceLot = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "StartTime"
                vStartTime = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "Step"
                vStepId = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "Technology"
                vTechnology = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "TesterId"
                vTesterId = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "TesterType"
                vTesterType = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "WaferId"
                vWaferID = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "WaferNumber"
                vWaferNumber = ToUpper(vAttributeValue)
            End If
            // CZ2-SPECIFIC: "Facility" key (bk uses "TestFacility")
            If vAttributeName = "Facility"
                vTestFacility = ToUpper(vAttributeValue)
            End If
            If vAttributeName = "TestFloor"
                vTestFloor = ToUpper(vAttributeValue)
            End If

        End If
    End While

    // DEBUG METADATA
    If DEBUG = 10
        Print("vArea = ", vArea, 'NL')
        Print("vDataFileName = ", vDataFileName, 'NL')
        Print("vAlternateProduct = ", vAlternateProduct, 'NL')
        Print("vFab = ", vFab, 'NL')
        Print("vLotID = ", vLotID, 'NL')
        Print("vLotType = ", vLotType, 'NL')
        Print("vProcess = ", vProcess, 'NL')
        Print("vProduct = ", vProduct, 'NL')
        Print("vPTI2 = ", vPTI2, 'NL')
        Print("vRecipe = ", vRecipe, 'NL')
        Print("vResultTime = ", vResultTime, 'NL')
        Print("vSlot = ", vSlot, 'NL')
        Print("vStepId = ", vStepId, 'NL')
        Print("vSourceLot = ", vSourceLot, 'NL')
        Print("vStartTime = ", vStartTime, 'NL')
        Print("vTechnology = ", vTechnology, 'NL')
        Print("vTesterId = ", vTesterId, 'NL')
        Print("vTesterType = ", vTesterType, 'NL')
        Print("vWaferID = ", vWaferID, 'NL')
        Print("vWaferNumber = ", vWaferNumber, 'NL')
        Print("vTestFacility = ", vTestFacility, 'NL')
        Print("vTestFloor = ", vTestFloor, 'NL')
    End If

    ClearSep
    // ========================= END METADATA SECTION ============================


    // =========================================================================
    //                  SECTION 2: FILE-LEVEL HEADER PARSING
    // =========================================================================

    AddSep('"')
    AddSep(' ')
    AddSep('{')
    AddSep('}')
    AddSep(';')
    AddSep(',')
    unitMultiplier = 0
    major_axis = 150
    minor_axis = 150
    el_orient = 0.0
    vDbToleranceDimensions(major_axis, minor_axis, el_orient)
    multiTiffFiles = False

    // --- Get wafer diameter (SampleSize) ---
    GoToBOF
    GoTo("SampleSize")
    vSampleSize = "NA"
    IF (ErrorCode = 0)
        SkipWords(1)
        Str = GetWord
        Str = StrTrim(Str, ',')
        charCounter = 0
        for i = 1 to StrLen(Str)
            charCounter = charCounter + 1
        end for
        If (charCounter > 6)
            unitDivisor = 1000
        Else If (charCounter = 6)
            unitDivisor = 1
        Else If (charCounter = 3)
            unitMultiplier = 1000
        Else
            Print("counter=", charCounter, 'NL')
            ExitScript("Unknown Wafer size unit. please check with owner of defect file.")
        End If
        wf_size = StrToReal(StrTrim(Str, ','))
        vSampleSize = Left(Str, 3)
        If (unitMultiplier <> 0)
            wf_size = wf_size * unitMultiplier
        Else
            wf_size = wf_size / unitDivisor
        End If
    Else
        ExitScript("ERROR: No wafer diameter provided.")
    End If

    // --- Get Device/Product ID ---
    GoToBOF
    GoTo("DeviceID")
    ProductID_Str = GetQuotedWord('"')

    // --- Get Fab ID ---
    GoToBOF
    GoTo("FabID")
    fabIdFromFile = GetQuotedWord('"')

    // --- Get Die Pitch ---
    GoToBOF
    GoTo("DiePitch")
    DelSep(',')
    SkipWords(1)
    Str = Before(GetWord, ',')

    IF (ErrorCode = 0)
        die_wd = StrToReal(Str)
        die_ht = GetReal
        die_wd = die_wd / unitDivisor
        die_ht = die_ht / unitDivisor
    Else
        ExitScript("ERROR: No die dimensions provided.")
    End If
    AddSep(',')
    cluster_die_wd = die_wd
    cluster_die_ht = die_ht

    // Determine patterned vs unpatterned
    If (wf_size = cluster_die_wd)
        PTRN_Str = "_UNPTRN"
        die_wd = 3000
        die_ht = 3000
    Else
        PTRN_Str = "_PTRN"
    End If


    // =========================================================================
    //              SECTION 3: PROGRAM NAME CONSTRUCTION
    // =========================================================================

    Prog_Str = programPrefix

    // CZ2-SPECIFIC: Prefer ProbeProgramName (vProgramName) over Product (vProduct)
    If ((vProgramName <> "") AND (vProgramName <> "NA"))
        Prog_Str = StrCat(Prog_Str, vProgramName)
    Else
        Prog_Str = StrCat(Prog_Str, ProductID_Str)
    End If

    // Append patterned/unpatterned indicator
    Prog_Str = StrCat(Prog_Str, PTRN_Str)

    // Append wafer size (fixes 'Found 2 unique substrate sizes' error)
    Prog_Str = StrCat(Prog_Str, "_")
    Prog_Str = StrCat(Prog_Str, vSampleSize)

    // Append format suffix
    Prog_Str = StrCat(Prog_Str, programSuffix)

    DpProgram_Str = vDbProgram(Prog_Str)
    PTRN_Str = ""


    // =========================================================================
    //           SECTION 4: PROGRAM SETUP (if program is not new)
    // =========================================================================

    If (IsProgramNew = FALSE)

        // --- Sample Type ---
        GoToBOF
        GoTo("SampleType")
        SkipWords(1)
        DbSampleType

        // --- Product ---
        If ((vProduct <> "") AND (vProduct <> "NA"))
            str = vDbProduct(vProduct)
        Else
            str = vDbProduct(ProductID_Str)
        End If

        // --- Fab ---
        If ((vFab <> "") AND (vFab <> "NA") AND (vFab <> ":NULL"))
            str = vDbFab(vFab)
        Else
            str = vDbFab(fabIdFromFile)
        End If

        // --- EQUIP4 (AlternateProduct) ---
        If (vAlternateProduct <> "") AND (vAlternateProduct <> "NA")
            str = vDbEquip4(vAlternateProduct)
        End If

        // --- EQUIP6 (TestFacility) ---
        // CZ2-SPECIFIC: vTestFacility populated from "Facility" attribute key
        If (vTestFacility <> "") AND (vTestFacility <> "NA")
            str = vDbEquip6(vTestFacility)
        End If

        // --- Tester Info ---
        GoToBOF
        GoTo("InspectionStationID")
        IF (ErrorCode = 0)
            str = GetQuotedWord('"')
            TesterType_Str = GetQuotedWord('"')
            Tester_Str = GetQuotedWord('"')
            If ((vTesterType <> "") AND (vTesterType <> "NA"))
                str = vDbTesterType(vTesterType)
            Else
                str = vDbTesterType(TesterType_Str)
            End If
            If ((vTesterId <> "") AND (vTesterId <> "NA"))
                str = vDbTester(vTesterId)
            Else
                str = vDbTester(Tester_Str)
            End If
        Else
            Print("Warning: No tester name provided", 'NL')
        End If

        // --- Lot ID ---
        GoToBOF
        GoTo("LotRecord")
        IF (ErrorCode = 0)
            str = GetWord
            If (vLotID <> "NA")
                str = vDbLot(vLotID)
            Else
                str = vDbLot(str)
            End If
            If ((vSourceLot <> "") AND (vSourceLot <> "NA"))
                str = vDbSrcLot(vSourceLot)
            Else
                LotID_Str = vDbLot(Str)
                Print("LOT=", LotID_Str, 'NL')
                SkipWords(-1)
                SrcLotID_Str = vDbSrcLot(StrCat(Left(str, 9), ".S"))
                SourceLot_Str = vDbSrcLot(SourceLot_Str)
                Print("vDbSrcLot = ", SourceLot_Str, 'NL')
            End If
        Else
            ExitScript("ERROR: No LotID provided.")
        End If

        // --- CZ2-SPECIFIC: ISO date format "%Y/%m/%d %H:%M:%S" ---
        If ((vResultTime <> "") AND (vResultTime <> "NA"))
            str = vDbResultTime(vResultTime, "%Y/%m/%d %H:%M:%S")
        Else
            ExitScript("ERROR: No result time provided.")
        End If

        If ((vStartTime <> "") AND (vStartTime <> "NA"))
            str = vDbSetupTime(vStartTime, "%Y/%m/%d %H:%M:%S")
        Else
            Print("Warning: No Setup provided", 'NL')
        End If

        // --- Step, Recipe, Technology, PTI2, Process, LotType ---
        If ((vStepId <> "") AND (vStepId <> "NA"))
            str = vDbStep(vStepId)
        Else
            Print("Step is not provided")
        End If

        If ((vRecipe <> "") AND (vRecipe <> "NA"))
            str = vDbRecipe(vRecipe)
        Else
            Print("Recipe is not provided")
        End If

        If ((vTechnology <> "") AND (vTechnology <> "NA"))
            str = vDbTechnology(vTechnology)
        Else
            Print("No Technology provided")
        End If

        If ((vPTI2 <> "") AND (vPTI2 <> "NA"))
            str = vDbFamily(vPTI2)
        Else
            Print("No PTI2 provided")
        End If

        If ((vProcess <> "") AND (vProcess <> "NA"))
            str = vDbProcess(vProcess)
        Else
            Print("No Process provided")
        End If

        If ((vLotType <> "") AND (vLotType <> "NA"))
            vDbLotClass(vLotID, "LotType", "LotType", vLotType)
        Else
            Print("No LotType provided")
        End If

        // --- Orientation ---
        GoToBOF
        GoTo("SampleOrientationMarkType")
        IF (ErrorCode = 0)
            SkipWords(1)
            Flat_Type_Str = GetWord
            If (Flat_Type_Str = "NOTCH")
                flat_type = 'N'
            Else If (Flat_Type_Str = "FLAT")
                flat_type = 'F'
            Else
                ExitScript("ERROR: INVALID SampleOrientationMarkType provided.")
            End If
        Else
            Print("Warning: SampleOrientationMarkType not provided.", 'NL')
        End If

        GoToBOF
        GoTo("OrientationMarkLocation")
        IF (ErrorCode = 0)
            SkipWords(1)
            Flat_Location_Str = GetWord
            If (Flat_Location_Str = "0")
                flat_location = 'B'
            Else If (Flat_Location_Str = "180")
                flat_location = 'T'
            Else If (Flat_Location_Str = "270")
                flat_location = 'R'
            Else If (Flat_Location_Str = "90")
                flat_location = 'L'
            Else
                ExitScript("ERROR: INVALID OrientationMarkLocation provided.")
            End If
        End If

        // --- Position type and wafer type ---
        If (wf_size = cluster_die_wd)
            pos_type = 1
            wafer_type = 0
        Else
            pos_type = 0
            wafer_type = 1
        End If
        vPosType(pos_type)

        wafer_type = 1
        vDbIsWaferPatterned(wafer_type)


        // =========================================================================
        //    SECTION 5: CLASS LOOKUP, DIE MAP, IMAGE FILE (file-level, GoToBOF OK)
        // =========================================================================

        // --- Class LUT ---
        GoToBOF
        GoTo("ClassLookupList")
        IF (ErrorCode = 0)
            SkipWords(-1)
            SkipLines(5)
            While (IsNumber(GetWord))
                SkipWords(-1)
                num = GetInt
                Class_Str = GetQuotedWord('"')
                Str = GetLine
                vAddToClassLUT(num, Class_Str)
            End While
        Else
            Print("Warning: No class LUT provided", 'NL')
        End If

        // --- Removed Die List ---
        dieCnt = 0
        GoToBOF
        GoTo("RemovedDieList")
        IF (ErrorCode = 0)
            SkipWords(-1)
            SkipLines(1)
            While (IsNumber(GetWord))
                dieCnt = dieCnt + 1
                SkipWords(-1)
                diex[dieCnt] = GetInt
                diey[dieCnt] = GetInt
                dieType[dieCnt] = 'R'
            End While
        Else
            Print("Warning: No RemovedDieList provided", 'NL')
        End If

        // --- Sample Test Plan List ---
        GoToBOF
        GoTo("SampleTestPlanList")
        IF (ErrorCode = 0)
            SkipWords(-1)
            SkipLines(5)
            While (IsNumber(GetWord))
                dieCnt = dieCnt + 1
                SkipWords(-1)
                diex[dieCnt] = GetInt
                diey[dieCnt] = GetInt
                dieType[dieCnt] = 'V'
            End While
        Else
            Print("Warning: No SampleTestPlanList provided", 'NL')
        End If

        // --- TIFF image file ---
        GoToBOF
        img_file = "NA"
        GoTo("Images")
        IF (ErrorCode = 0)
            img_file = GetWord
        Else
            Print("WARNING: No TIFF file", 'NL')
        End If


        // =========================================================================
        //          SECTION 6: COUNT WAFER RECORDS
        // =========================================================================

        GoToBOF
        HowManyRecords = 0
        GoTo("WaferRecord")
        IF (ErrorCode = 0)
            While (ErrorCode = 0)
                HowManyRecords = HowManyRecords + 1
                GoTo("WaferRecord")
            End While
            Print('NL', "Number of records ", HowManyRecords, 'NL')
        Else
            ExitScript("ERROR: Could not count how many records in file.")
        End If

        // --- Wafer ID and Slot ---
        If ((vWaferID <> "") AND (vWaferID <> "NA"))
            If ((vWaferNumber <> "") AND (vWaferNumber <> "NA"))
                wfid = StrToInt(vWaferNumber)
            Else
                Print("No wafer number provided")
                wfid = -1
            End If
            DbWfNum(vWaferID, wfid)
        Else
            ExitScript("ERROR: No WaferID.")
        End If

        If ((vSlot <> "") AND (vSlot <> "NA"))
            vDbSlotNum(StrToInt(vSlot))
        Else
            Print("No slot provided")
        End If


        // =========================================================================
        //  SECTION 7: PER-WAFER-RECORD PROCESSING (MULTI-WAFER SAFE)
        //  FIX #7: Forward-only GoTo — no GoToBOF inside this loop.
        //  GoTo("WaferRecord") advances to the next record each iteration,
        //  and all subsequent GoTo calls search forward within that record.
        // =========================================================================

        GoToBOF  // Position to start of file ONCE before the record loop

        For record = 1 To HowManyRecords

            // --- Position to this WaferRecord (forward search) ---
            GoTo("WaferRecord")

            // --- Get test_area (forward within this record) ---
            GoTo("AreaPerTest")
            IF (ErrorCode = 0)
                SkipWords(1)
                test_area = GetReal
                test_area = test_area / unitDivisor
            Else
                Print("Warning: No test area provided", 'NL')
            End If

            // --- Get Wafer center (forward within this record) ---
            GoTo("SampleCenterLocation")
            IF (ErrorCode = 0)
                SkipWords(1)
                Str = GetWord
                wf_xcenter = StrToReal(StrTrim(Str, ','))
                wf_ycenter = GetReal
                wf_xcenter = wf_xcenter / unitDivisor
                wf_ycenter = wf_ycenter / unitDivisor
            Else
                ExitScript("ERROR: No wafer center location provided.")
            End If

            // Wmap config
            wmap_name_str = DpProgram_Str
            wf_units = "microns"

            // --- Get Die Origin (forward within this record) ---
            GoTo("DieOrigin")
            IF (ErrorCode = 0)
                SkipWords(1)
                Str = GetWord
                center_x = StrToReal(StrTrim(Str, ','))
                center_y = GetReal
                center_x = center_x / unitDivisor
                center_y = center_y / unitDivisor
                center_x = center_x - wf_xcenter
                center_y = center_y - wf_ycenter
            Else
                ExitScript("ERROR: No die origin provided.")
            End If

            // Reticle info (not from KLARF)
            fld_rows = 1
            fld_cols = 1
            row_offset = 0
            col_offset = 0
            xPosDir = 'R'

            vDbWmapCfg(wmap_name_str, wf_size,
                wf_units,      flat_location,
                flat_type,     die_wd,
                die_ht,        center_x,
                center_y,      xPosDir,
                'U',           fld_rows,
                fld_cols,      row_offset,
                col_offset)

            // Apply die map entries
            For j = 1 To dieCnt
                vDbAddToDieMapTable(diex[j], diey[j], dieType[j])
            End For


            // =============================================================
            //  SECTION 7A: DEFECT RECORD SPEC + DEFECT LIST PARSING
            //  FIX #1: IMAGEINFO consumes full image list block
            //  FIX #4: NotEndOfFile guard on defect loop
            //  FIX #5: Dead IMAGEINFO handler removed
            //  FIX #8: Unknown column types handled without SkipWords(-1)
            // =============================================================

            GoTo("DefectList")
            IF (ErrorCode = 0)

                // Reset column-parsing flags
                do_cluster    = FALSE
                do_roughbin   = FALSE
                do_finebin    = FALSE
                do_review     = FALSE
                do_imagelist  = FALSE
                do_autosem    = FALSE
                do_mansem     = FALSE
                do_confidence = FALSE
                do_cn_conf    = FALSE

                // --- Parse DefectRecordSpec columns ---
                GoTo("YSIZE,")
                itemNum = 1
                SkipWords(1)
                str = GetWord

                while ((str <> "Data") and (str <> "TiffFileName") and (str <> "TiffFilename") and (str <> "TiffSpec"))

                    Item[itemNum] = StrTrim(Str, ',')
                    str = GetWord

                    if str = "int32"
                        // known type — consumed
                    else if str = "float"
                        // known type — consumed
                    else if str = "ImageList"
                        // known type — consumed
                    else if str = "double"
                        // known type — consumed
                    else
                        // FIX #8: Unknown type — already consumed, do nothing.
                        // Do NOT SkipWords(-1) which would misread type as column name.
                    end if

                    If D
                        Print("Items:", 'NL')
                        Print(Item[itemNum], 'NL')
                    End If
                    str = GetWord
                    itemNum = itemNum + 1
                end while

                SkipWords(-1)
                SkipLines(1)

                intensity = -1

                str = GetWord

                // FIX #4: NotEndOfFile guard on defect record loop
                While ((IsNumber(str)) OR (str = "TiffFileName")) AND NotEndOfFile

                    if (str = "TiffFileName")
                        multiTiffFiles = True
                        img_file = StrTrim(GetWord, '"')
                        SkipWords(-1)
                        SkipLines(2)
                        Str = GetWord
                    end if

                    SkipWords(-1)
                    df_index = GetInt

                    xPos = GetReal
                    yPos = GetReal
                    xPos = xPos / unitDivisor
                    yPos = yPos / unitDivisor
                    xInd = GetInt
                    yInd = GetInt
                    x_size = GetReal
                    y_size = GetReal
                    x_size = x_size / unitDivisor
                    y_size = y_size / unitDivisor

                    For j = 1 to itemNum - 1
                        If Item[j] = "DSIZE"
                            df_size = GetReal
                            df_size = df_size / unitDivisor
                        Else If Item[j] = "TEST"
                            test_num = GetInt
                        Else If Item[j] = "CLUSTERNUMBER"
                            do_cluster = TRUE
                            cluster = GetInt
                        Else If Item[j] = "CLASSNUMBER"
                            manualclass = GetInt
                        Else If Item[j] = "DEFECTAREA"
                            df_area = GetReal
                            df_area = df_area / unitDivisor
                        Else If Item[j] = "ROUGHBINNUMBER"
                            do_roughbin = TRUE
                            roughbin = GetInt
                        Else If Item[j] = "FINEBINNUMBER"
                            do_finebin = TRUE
                            finebin = GetInt
                        Else If Item[j] = "REVIEWSAMPLE"
                            do_review = TRUE
                            review = GetInt
                        // FIX #1: POLARITY — read into temp variable only
                        Else If Item[j] = "POLARITY"
                            num = GetInt
                            If Not do_imagelist
                                img_cnt = num
                                img_list = num
                            End If
                        // FIX #1: IMAGEINFO — fully consume the image list block
                        Else If Item[j] = "IMAGEINFO"
                            Str = GetWord
                            if Str = "Images"
                                do_imagelist = TRUE
                                img_cnt = GetInt
                                img_list = img_cnt
                                For k = 1 to img_cnt
                                    str = GetWord
                                    imgFileArr[k] = str
                                    SkipWords(1)
                                    str = GetWord
                                    imgArr[k] = StrToInt(str)
                                    SkipWords(1)
                                End For
                            End If
                        Else If Item[j] = "AUTOSEMCLASS"
                            do_autosem = TRUE
                            autosem = GetInt
                        Else If Item[j] = "MANSEMCLASS"
                            do_mansem = TRUE
                            mansem = GetInt
                        Else If Item[j] = "CONFIDENCE"
                            do_confidence = TRUE
                            confidence = GetReal
                        Else If Item[j] = "CN_CONFIDENCE"
                            do_cn_conf = True
                            cn_conf = GetReal
                        Else
                            Str = GetWord
                        End if
                    End For

                    // Debug output
                    If D print ('NL',
                        "--------------------------", 'NL',
                        "df_index    = ", df_index,    'NL',
                        "xInd        = ", xInd,        'NL',
                        "yInd        = ", yInd,        'NL',
                        "y_size      = ", y_size,      'NL',
                        "df_size     = ", df_size,     'NL',
                        "df_area     = ", df_area,     'NL',
                        "manClass    = ", manualclass, 'NL',
                        "Test num    = ", test_num,    'NL',
                        "cluster num = ", cluster,     'NL',
                        "review      = ", review,      'NL',
                        "rough       = ", roughbin,    'NL',
                        "fine        = ", finebin,     'NL',
                        "autosem     = ", autosem,     'NL',
                        "mansem      = ", mansem,      'NL',
                        "confidence  = ", confidence,  'NL',
                        "cn_conf     = ", cn_conf,     'NL',
                        "img_list    = ", img_list,    'NL',
                        "img_cnt     = ", img_cnt,     'NL')
                    End If

                    SkipWords(-1)
                    SkipLines(1)

                    vDbAddToDieMapTable(xInd, yInd, 'V')
                    vDbDefect(df_index, xInd,      yInd,
                        xPos,           yPos,      x_size,
                        y_size,         df_area,   df_size,
                        cluster,        intensity, test_num)

                    if (manualclass > 0)
                        vAddToClassLUT(manualclass, StrCat("manClass_", IntToStr(manualclass)))
                        vDbAddDefectClass(df_index, manualclass, 1)
                        vDbSetCriticalDfClass(manualclass, 1)
                    end if

                    if (roughbin > 0) AND (do_roughbin = TRUE)
                        if (manualclass = 0)
                            manualclass = roughbin
                            vAddToClassLUT(manualclass, StrCat("manClass_", IntToStr(manualclass)))
                            vDbAddDefectClass(df_index, manualclass, 1)
                            vDbSetCriticalDfClass(manualclass, 1)
                        end if
                        vAddToClassLUT(roughbin, StrCat("roughBin_", IntToStr(roughbin)))
                        vDbAddDefectClass(df_index, roughbin, 2)
                        vDbSetCriticalDfClass(roughbin, 2)
                    end If

                    if (finebin > 0) AND (do_finebin = TRUE)
                        vAddToClassLUT(finebin, StrCat("fineBin_", IntToStr(finebin)))
                        vDbAddDefectClass(df_index, finebin, 3)
                        vDbSetCriticalDfClass(finebin, 3)
                    end if

                    if (mansem > 0) AND (do_mansem = TRUE)
                        vAddToClassLUT(mansem, StrCat("manSem_", IntToStr(mansem)))
                        vDbAddDefectClass(df_index, mansem, 4)
                        vDbSetCriticalDfClass(mansem, 4)
                    end if

                    if (autosem > 0) AND (do_autosem = TRUE)
                        vAddToClassLUT(autosem, StrCat("autoSem_", IntToStr(autosem)))
                        vDbAddDefectClass(df_index, autosem, 5)
                        vDbSetCriticalDfClass(autosem, 5)
                    end if

                    img_path = Argument

                    If ((img_list <> 0) and (img_cnt > 0) and (img_file <> "NA"))
                        For k = 1 to Img_cnt
                            img_file = imgFileArr[k]
                            If D print ("img_file [", imgArr[k], "] was added", 'NL') End If
                        End For
                    End If

                    str = GetWord

                End While //ends defect loop


                // =============================================================
                //  SECTION 7B: TEST SUMMARY LIST (forward within this record)
                //  FIX #3: haze/areapertest as real + GetReal
                //  FIX #3: NotEndOfFile evaluated before GetWord
                // =============================================================

                GoTo("TestSummaryList")
                If (ErrorCode = 0)
                    GoTo("Columns")
                    cols_cnt = GetInt
                    GoTo("Data")
                    IF (ErrorCode = 0)
                        SkipWords(1)

                        While (NotEndOfFile AND IsNumber(GetWord))
                            SkipWords(-1)
                            test_num = GetInt
                            def_cnt = GetInt
                            dd = GetReal
                            insp_die = GetInt
                            def_die = GetInt
                            haze_reg = GetReal
                            haze_avg = GetReal
                            haze_std = GetReal
                            haze_med = GetReal
                            haze_peak = GetReal
                            areapertest = GetReal
                            vDbDefectSummary(test_num, def_cnt,
                                test_area, dd,
                                insp_die, def_die)
                            SkipWords(-1)
                            SkipLines(1)
                        End While
                    Else
                        Print("Warning: Could not find Data in summaries section of KLARF file", 'NL')
                    End If
                Else
                    Print("Warning: Could not find summaries in KLARF file", 'NL')
                End If
                dBDumpLayer()

            Else
                ExitScript("ERROR: Could not find defectlist")
            End If

        End For //ends record loop

    Else //the program is new
        Print("The program is New!", 'NL')
        TestNum = 0
        DD_Threshold = 2.3
        DC_Threshold = 1000
        DbDumpLayer()
    End If

End
